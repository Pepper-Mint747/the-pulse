# OpenWA gateway on your other server (base URL, without /api)
WA_API_URL=http://192.168.1.50:8002
# Leave empty if open-wa was started without --api-key
WA_API_KEY=
# OpenWA session name or id (as shown in the dashboard). Empty = the only connected session
WA_SESSION=kenyabot
# Your WhatsApp number: 254 + number without the leading 0, then @c.us
WA_TO=2547XXXXXXXX@c.us

# Notification times, 24-hour HH:MM, Nairobi time. Separate several times with commas.
# Leave a line commented out to use config.toml / defaults. Set it to empty to turn that alert off.
#SCHEDULE_BRIEFING=06:00
#SCHEDULE_RAIN_MORNING=05:30
#SCHEDULE_RAIN_EVENING=15:00
#SCHEDULE_NEWS=18:00
#SCHEDULE_KPLC=08:00,10:00,12:00,14:00,16:00,18:00,20:00
#SCHEDULE_KPLC_REMIND=19:05
# NSE: daily close signals (trading days) and weekly review. Weekly takes "day HH:MM".
#SCHEDULE_NSE_DAILY=15:45
#SCHEDULE_NSE_WEEKLY=fri 17:00
